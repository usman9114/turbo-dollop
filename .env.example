# Optional: faster Hugging Face downloads
# HF_HUB_ENABLE_HF_TRANSFER=1
# fal.ai key for hosted Flux + Wan 2.1 (https://fal.ai/dashboard/keys)
FAL_KEY=

# --- Product hunter (python -m hunter); see hunter/README.md ---
HUNTER_POSTAL_CODE=80331
HUNTER_RADIUS_KM=50
# Claude models (screening / deep review)
# HUNTER_SCREEN_MODEL=claude-haiku-5-5
# HUNTER_REVIEW_MODEL=claude-sonnet-5-5
# Kleinanzeigen live search: OFF unless you set 1 (against their ToS §5; your call)
HUNTER_KA_LIVE=0
# HUNTER_KA_MIN_INTERVAL_S=30
# HUNTER_KA_DAILY_CAP=100
# eBay Browse API (developer.ebay.com -> Application Keys -> Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Mailbox that receives your Kleinanzeigen saved-search alerts
HUNTER_IMAP_HOST=imap.gmail.com
HUNTER_IMAP_USER=
HUNTER_IMAP_PASSWORD=
# Telegram deal cards (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tax mode: 25a (margin scheme) or kleinunternehmer
HUNTER_VAT_MODE=25a
