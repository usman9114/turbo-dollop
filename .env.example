# Copy to .env and fill in. Every source is optional; the bot uses what is configured.

# Screening team on OpenRouter (Reader -> Inspector -> Skeptic, code Judge). See README "Screening team".
OPENROUTER_API_KEY=
# auto = OpenRouter if its key is set, else Claude if ANTHROPIC_API_KEY is set, else rules only
# (openrouter | anthropic | rules to force one)
HUNTBOT_SCREEN_PROVIDER=auto
# glm = z-ai GLM models (cheap, paid, no daily cap); free = :free models only (50 requests/day,
# 1000/day after buying >= $10 credits once)
HUNTBOT_AGENT_PROFILE=glm
# Optional model chains (comma separated, primary first, rest are OpenRouter fallbacks)
# HUNTBOT_TEAM_READER_MODELS=z-ai/glm-5.3-flash,z-ai/glm-4.7-flash,google/gemma-4-31b-it:free
# HUNTBOT_TEAM_INSPECTOR_MODELS=z-ai/glm-5.3-flash,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# HUNTBOT_TEAM_SKEPTIC_MODELS=z-ai/glm-5.3,nvidia/nemotron-3-ultra-550b-a55b:free,xingchen-agi/xing4.0-29b-a4b:free
# Shadow mode: verdicts are shown on cards/web but alerts behave as before. Set true after reviewing them.
HUNTBOT_TEAM_ENFORCE=false
# WATCH verdicts are still pushed when the rules say alert
HUNTBOT_PUSH_WATCH=true
# Paid-model spend cap per UTC day, and requests per unattended run
HUNTBOT_AGENT_MAX_USD_DAY=0.50
HUNTBOT_AGENT_MAX_CALLS_RUN=40
# Free-model allowance (only :free ids): per-run cap, seconds per run, daily cap (default server limit - 3),
# reserve kept for interactive use (default 10 at 50/day, 150 at 1000/day), minutes before a queued listing is pushed unscreened
HUNTBOT_AGENT_RUN_CAP=12
HUNTBOT_AGENT_RUN_SECONDS=300
# HUNTBOT_AGENT_DAILY_CAP=
# HUNTBOT_AGENT_RESERVE=
HUNTBOT_AGENT_MAX_WAIT_MIN=45
# Paid model ids are refused unless the profile is glm or this is true
HUNTBOT_OR_ALLOW_PAID=false
HUNTBOT_OR_TIMEOUT=60

# Claude (alternative screener). Without any key the bot falls back to rule-based scoring only.
ANTHROPIC_API_KEY=
HUNTBOT_SCREEN_MODEL=claude-haiku-5-5
HUNTBOT_REVIEW_MODEL=claude-sonnet-5-5
HUNTBOT_LLM_ENABLED=true

# eBay Browse API (developer.ebay.com -> Application Keys, Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ZIP=80331

# Mailbox that receives your Kleinanzeigen saved-search alerts (use a dedicated Gmail + app password)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Telegram (create a bot with @BotFather; get your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local server used by the web UI and the browser userscript
HUNTBOT_DB=huntbot.db
HUNTBOT_PORT=8787
HUNTBOT_TOKEN=change-me-to-a-random-string

# Business assumptions (see plan section 4.2)
HUNTBOT_KLEINUNTERNEHMER=false
HUNTBOT_HOME_LOCATION_SLUG=muenchen
HUNTBOT_HOME_LOCATION_ID=6411
HUNTBOT_RADIUS_KM=30
HUNTBOT_DEFAULT_TRAVEL_KM=20

# Tier 1 on-demand Kleinanzeigen search. OFF by default: it sends automated requests to
# kleinanzeigen.de, which their terms (§5) forbid, and can get your IP/account blocked.
# Rate-limited to 1 request / 30 s and 100 / day; pauses 24 h on any block. Your decision.
HUNTBOT_ONDEMAND=false
HUNTBOT_ONDEMAND_PAGES=1
